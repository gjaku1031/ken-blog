https://static.127.0.0.1.nip.io {
  tls internal
  encode gzip

  handle_path /ken-blog/* {
    root * /srv/static
    header Cache-Control "max-age=600"
    try_files {path} {path}index.html
    file_server
  }
  handle {
    respond "Not found" 404
  }
}
