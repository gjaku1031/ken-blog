<main id="main-content" class="post-page page-container">
  <a class="back-link" href="{{ base + ('projects/' if project else 'posts/') }}">{{ '← Projects' if project else '← Posts' }}</a>
  <article>
    <div class="post-overline">
      <a href="{{ base + ('projects/' if project else 'posts/') }}">{{ 'Projects' if project else 'Posts' }}</a>{% if post.category %}<span> · </span>{% endif %}{% if post.category %}<span class="category-breadcrumb">{% for part in post.categoryTrail %}{% if not loop.first %}<span aria-hidden="true">›</span>{% endif %}<a href="{{ base + 'posts/?category=' + (part.path | query) }}">{{ part.name }}</a>{% endfor %}</span>{% endif %}
    </div>
    <h1>{{ post.title }}</h1>
    {% if project %}<div class="project-overview">
      <div class="project-card-top"><span class="project-status project-status-{{ project.statusClass }}"><span aria-hidden="true"></span>{{ project.statusLabel }}</span>{% if project.period %}<span class="mono project-period">{{ project.period }}</span>{% endif %}</div>
      {% if project.description %}<p class="project-description">{{ project.description }}</p>{% endif %}
      <div class="stack-badges">{% for badge in project.stackBadges %}<span><img alt="" width="22" height="22" src="{{ badge.imageUrl }}" data-stack-name="{{ badge.name }}">{{ badge.name }}</span>{% endfor %}</div>
    </div>{% endif %}
    {% if post.relatedProject %}<p class="post-related-project">
      <span>[연관 프로젝트]</span><a href="{{ post.relatedProject.href }}">{{ post.relatedProject.name }}</a>
    </p>{% endif %}
    <div class="detail-meta">
      <time class="mono" datetime="{{ post.publishedDate }}">{{ post.displayDate }}</time>
    </div>
    {% if post.tags | length %}<div class="tag-list detail-tags">
      {% for tag in post.tags %}<a href="{{ base + 'posts/?tag=' + (tag | query) }}">#{{ tag }}</a>{% endfor %}
    </div>{% endif %}
    <div class="post-reading-layout {{ 'has-toc' if (toc | length) or (series | length) else '' }}">
      <div class="post-main-content">
        <div class="markdown-body">{{ html | safe }}</div>
        {% include "views/backlinks.njk" %}
        {% if previousPost or nextPost %}<nav class="series-previous-next" aria-label="이전·다음 글">
          {% if previousPost %}<a class="series-previous" rel="prev" href="{{ previousPost.href }}"><span>← 이전 글 · {{ previousPost.order }}편</span><strong>{{ previousPost.title }}</strong></a>{% else %}<div class="series-start" aria-hidden="true"></div>{% endif %}
          {% if nextPost %}<a class="series-next" rel="next" href="{{ nextPost.href }}"><span>다음 글 · {{ nextPost.order }}편 →</span><strong>{{ nextPost.title }}</strong></a>{% else %}<p class="series-end">마지막 글입니다</p>{% endif %}
        </nav>{% endif %}
      </div>
      {% if toc | length or series | length %}<aside class="post-side-rail can-stick">
        {% include "views/toc.njk" %}
        {% if series | length %}<nav class="series-nav" aria-label="시리즈 글 목록">
          <h2>{{ seriesName }}</h2>
          <ol>
            {% for item in series %}<li>
              <a href="{{ item.href }}"{% if item.current %} aria-current="page"{% endif %}><span class="series-number">{{ item.order }}</span><span>{{ item.title }}</span></a>
            </li>{% endfor %}
          </ol>
          <p class="series-progress mono" aria-label="전체 {{ series | length }}편 중 {{ seriesPosition }}번째 글">{{ seriesPosition }}/{{ series | length }}</p>
        </nav>{% endif %}
      </aside>{% endif %}
    </div>
  </article>
</main>
