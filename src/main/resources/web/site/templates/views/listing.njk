<main id="main-content" class="page-container {{ 'search-page' if searching else 'tech-page' }}">
  <div class="content-grid">
    <section class="feed-column">
      <div class="section-heading">
        <h1>{{ heading }}</h1>
        {% if section == "Posts" %}<a class="write-button" data-admin-write href="{{ base }}posts/new/" hidden>글쓰기</a>{% endif %}
      </div>
      {% if searching %}<p id="search-filter" class="active-filters">
      </p>{% endif %}
      <div class="post-list">{% include "views/cards.njk" %}</div>
      <p id="filter-empty" class="message-card card" hidden>검색 결과가 없습니다.</p>
    </section>
    {% include "views/sidebar.njk" %}
  </div>
</main>
