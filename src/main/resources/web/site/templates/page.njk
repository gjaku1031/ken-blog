{# 공개 페이지 메타데이터와 공통 틀 #}{# 공개 페이지 공통 메타데이터·탐색·본문·하단 틀 #}<!doctype html>
<html lang="ko">
  {# 페이지별 SEO·공유 메타데이터 #}<head>
    <meta charset="utf-8">
    {% include "analytics.njk" %}
    {% include "theme-init.njk" %}
    <meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ documentTitle }}</title>
    <meta name="description" content="{{ summary }}">
    <meta property="og:title" content="{{ socialTitle }}">
    <meta property="og:description" content="{{ summary }}">
    <meta property="og:url" content="{{ canonical }}">
    <meta property="og:site_name" content="ken.blog">
    <meta property="og:locale" content="ko_KR">
    <meta property="og:type" content="{{ ogType }}">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ socialTitle }}">
    <meta name="twitter:description" content="{{ summary }}">
    <link rel="canonical" href="{{ canonical }}">
    <link rel="stylesheet" href="{{ assetsCss }}">{% if articleCss %}<link rel="stylesheet" href="{{ articleCss }}">{% endif %}</head>
  <body data-route="{{ section | lower }}" data-api-base="{{ apiBase }}" data-forms-css="{{ formsCss }}"{% if searchIndex %} data-search-index="{{ searchIndex }}"{% endif %}>
    <div class="site-root">
      <a class="skip-link" href="#main-content">본문으로 건너뛰기</a>
      {% include "header.njk" %}
      <div class="site-content">
        {# 페이지 종류에 맞는 본문 뷰 삽입 #}{% include "views/" + view + ".njk" %}
      </div>
      {# 저장소·관리 링크 #}<footer class="site-footer">
        <span>© {{ year }} ken.blog</span>
        <div>
          <a rel="noopener noreferrer" href="{{ github }}">GitHub</a>{% if adminHref %}<a href="{{ adminHref }}">관리자</a>{% endif %}
        </div>
      </footer>
    </div>
    {# 본문 상호작용 초기화 #}<script type="module" src="{{ assetsJs }}"></script>{% if articleJs %}<script type="module" src="{{ articleJs }}"></script>{% endif %}
  </body>
</html>
