# 기존 서비스의 8080과 분리된 API 로컬 포트.
API_PORT=18081
# 쉼표로 구분한 정적 프론트 origin. 로컬 검증 때만 http://127.0.0.1:14000 추가.
APP_CORS_ALLOWED_ORIGINS=https://gjaku1031.github.io
# 개발 MySQL만 127.0.0.1에 노출. 운영 DB 연결 정보는 이 파일에 넣지 않음.
DB_PORT=13306
DB_USERNAME=ken_blog
# 로컬 .env에서 서로 다른 임의 비밀번호로 채움. 빈 값은 Compose 시작 시 거부.
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
# HTTP 127.0.0.1 개발 검증에서만 false. 운영 HTTPS에서는 true 유지.
SESSION_COOKIE_SECURE=true
# 초기 관리자 준비는 두 값 모두 입력할 때만 수행. 해시는 {bcrypt} 비용 10~14.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD_HASH=
# 로그인 API를 다른 로컬 origin에서 시험할 때만 정확한 origin 입력. 기본값은 비허용.
APP_AUTH_CORS_ALLOWED_ORIGINS=
# OCI Object Storage S3 호환 API. 다섯 연결 값은 모두 비우거나 모두 채움.
# 기존 비공개 버킷과 HTTPS path-style endpoint만 사용. 비밀키는 로컬 .env에만 입력.
OCI_OBJECT_STORAGE_ENDPOINT=
OCI_OBJECT_STORAGE_REGION=
OCI_OBJECT_STORAGE_BUCKET=
OCI_OBJECT_STORAGE_ACCESS_KEY=
OCI_OBJECT_STORAGE_SECRET_KEY=
# 격리 검증은 매 실행마다 별도 하위 접두사를 지정.
OCI_OBJECT_STORAGE_KEY_PREFIX=ken-blog/attachments
# 선택적 공개 본문 캐시. 기본 false이면 Redis 연결 없이 MySQL만 조회.
CACHE_REDIS_ENABLED=false
# 활성화 시 호스트 필수. 로컬 Redis 검증은 CACHE_REDIS_TLS=false로 설정.
CACHE_REDIS_HOST=
CACHE_REDIS_PORT=6379
CACHE_REDIS_USERNAME=
CACHE_REDIS_PASSWORD=
CACHE_REDIS_TLS=true
# 검증·운영 환경마다 소유 접두사를 구분. 실제 키는 :v1:post-body:{id}:{sha256}로 끝남.
CACHE_REDIS_PREFIX=ken-blog:public-posts
CACHE_REDIS_TTL_SECONDS=300
CACHE_REDIS_CONNECT_TIMEOUT_MS=300
CACHE_REDIS_COMMAND_TIMEOUT_MS=300
