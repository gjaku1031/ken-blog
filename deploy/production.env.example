# 저장소 밖 0600 파일로 복사하고 Docker Compose에 --env-file로 전달.
# KEN_BLOG_PRODUCTION_ENV_FILE은 이 파일의 절대 경로. 운영 MySQL과 기존 자료 보존.
KEN_BLOG_PRODUCTION_ENV_FILE=/home/ubuntu/Develop/infra/ken-blog/production.env
KEN_BLOG_ASSETS_DIR=/home/ubuntu/Develop/infra/ken-blog/assets
KEN_BLOG_CONTENT_DIR=/home/ubuntu/Develop/project/ken-blog/content
API_PORT=18081

# 공인 IP는 인증서의 SAN, 사설 NIC IP는 Docker의 80/443 호스트 바인딩.
# OCI 공인 IP -> 사설 NIC 포워딩 및 방화벽 80/443 허용 필요.
KEN_BLOG_PUBLIC_IP=
KEN_BLOG_PUBLIC_BIND_IP=

# Spring의 외부 MySQL 연결. 기존 스키마/계정/원고 삭제 금지.
DB_URL=jdbc:mysql://mysql-host:3306/ken_blog?sslMode=REQUIRED
DB_USERNAME=ken_blog
DB_PASSWORD=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD_HASH=
ADMIN_USERNAME=
ADMIN_TOTP_SECRET=
ADMIN_RECOVERY_CODE_HASHES=

# Pages 관리자 인증: 운영 Compose의 값도 동일하게 고정됨.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=none
SESSION_COOKIE_PARTITIONED=true
APP_CORS_ALLOWED_ORIGINS=https://gjaku1031.github.io
APP_AUTH_CORS_ALLOWED_ORIGINS=https://gjaku1031.github.io

# MCP는 127.0.0.1:18081에서만 사용. 활성화 시 Docker bridge gateway 한 개를
# APP_MCP_ALLOWED_PEERS에 추가하고, 공용 프록시에는 /mcp를 열지 않는다.
APP_MCP_ENABLED=false
APP_MCP_ALLOWED_PEERS=127.0.0.1,::1
APP_MCP_ALLOWED_HOSTS=127.0.0.1:18081
APP_ASSETS_KEY_PREFIX=ken-blog/attachments
