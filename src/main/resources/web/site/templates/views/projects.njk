<main id="main-content" class="page-container projects-page">
  <div class="projects-heading">
    <h1>Projects</h1><a class="write-button" data-admin-write href="{{ base }}projects/new/" hidden>글쓰기</a>
  </div>
  <div class="projects-grid">
    {% for project in projects %}<article class="project-card card hv">
      <div class="project-card-top">
        <span class="project-status {{ 'project-status-' + project.statusClass }}"><span aria-hidden="true"></span>{{ project.statusLabel }}</span>{% if project.period %}<span class="mono project-period">{{ project.period }}</span>{% endif %}
      </div>
      <h2>
        <a href="{{ project.href }}">{{ project.name }}</a>
      </h2>
      <p>{{ project.description }}</p>
      {% if project.stackBadges | length %}<div class="stack-badges" aria-label="기술 배지">
        {% for badge in project.stackBadges %}<span><img alt="" width="22" height="22" src="{{ badge.imageUrl }}" data-stack-name="{{ badge.name }}">{{ badge.name }}</span>{% endfor %}
      </div>{% endif %}
      <div class="project-card-counts">문서 {{ project.postCount }}개</div>
    </article>{% endfor %}
    <button id="new-project" class="project-create-card" type="button" data-admin-write hidden><span aria-hidden="true">+</span>새 프로젝트</button>
  </div>
  {% if not projects | length %}<p class="projects-empty">아직 출간된 프로젝트가 없습니다.</p>{% endif %}
  <dialog id="project-dialog" class="edit-dialog" aria-labelledby="project-dialog-title">
    <div class="dialog-heading"><h2 id="project-dialog-title">새 프로젝트</h2><button id="project-dialog-close" class="project-dialog-close" type="button" aria-label="닫기">×</button></div>
    <p id="project-dialog-message" class="notice" role="status" hidden></p><div id="project-dialog-content"></div>
  </dialog>
</main>
