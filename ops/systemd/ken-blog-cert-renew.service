[Unit]
Description=Renew ken-blog API IP certificate
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
TimeoutStartSec=30min
EnvironmentFile=/home/ubuntu/Develop/infra/ken-blog/public-cert.env
ExecStart=/home/ubuntu/Develop/project/ken-blog/ops/renew-ip-certificate.sh
