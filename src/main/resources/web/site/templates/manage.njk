<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  {% include "theme-init.njk" %}
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title>{{ '글쓰기' if editor else '관리' }} · ken.blog</title>
  <link rel="stylesheet" href="{{ adminCss }}">
  <script type="module" src="{{ adminJs }}"></script>
</head>
<body data-route="manage" data-api-base="{{ apiBase }}" data-editor="{{ editor }}">
  <a class="skip-link" href="#content">본문으로 이동</a>
  {% include "header.njk" %}
  <div id="boot" class="boot" role="status">관리자 연결을 확인하는 중입니다.</div>
  <section id="login" class="login-card card" hidden aria-labelledby="login-title">
    <h1 id="login-title">관리자 로그인</h1>
    <p id="login-message" class="notice error" role="alert" hidden></p>
    <form id="login-form" autocomplete="on"><label for="password">비밀번호</label><input id="password" name="password" type="password" autocomplete="current-password" required><label class="check"><input name="rememberMe" type="checkbox"> 30일 동안 로그인 유지</label><button class="button primary" type="submit">로그인</button></form>
    <a class="text-link" href="/ken-blog/">블로그로 돌아가기</a>
  </section>
  <div id="dashboard" class="{{ 'editor-layout' if editor else 'admin-layout' }}" hidden>
    {% if not editor %}<aside class="admin-sidebar"><nav aria-label="관리 메뉴"><a href="#posts" data-panel-link="posts">글 관리</a><a href="#categories" data-panel-link="categories">분류 관리</a><a href="#series" data-panel-link="series">시리즈·프로젝트</a><a class="admin-deploy button" href="https://github.com/gjaku1031/ken-blog/actions/workflows/pages.yml" target="_blank" rel="noopener noreferrer">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.56 9.56 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2z"/></svg>
      <span>GitHub Pages 배포</span>
    </a></nav></aside>{% endif %}
    <main id="content" tabindex="-1">
      <p id="dashboard-message" class="notice" role="status" hidden></p>
      {% if editor %}
      <a class="back-link" href="/ken-blog/{{ 'projects' if editor == 'project' else 'posts' }}/">← {{ 'Projects' if editor == 'project' else 'Posts' }}</a>
      <div class="page-heading"><h1>{{ 'Projects' if editor == 'project' else 'Posts' }} 글쓰기</h1></div>
      <div id="editor-content" class="card editor-card"></div>
      {% else %}
      <section id="posts" data-panel>
        <div class="page-heading"><h1>글 관리</h1><span id="post-count" class="muted mono"></span></div>
        <div class="card list-card"><div id="post-list"></div><div id="post-pages" class="pagination"></div></div>
      </section>
      <section id="categories" data-panel hidden><div class="page-heading"><h1>분류 관리</h1></div><div class="card panel category-card"><div id="category-create"></div><div id="category-list"></div></div></section>
      <section id="series" data-panel hidden>
        <div class="page-heading series-heading"><h1>시리즈·프로젝트</h1><div id="series-create" class="heading-actions"></div></div>
        <div class="card panel"><div id="series-list"></div></div>
      </section>
      {% endif %}
    </main>
  </div>
  <dialog id="edit-dialog" class="edit-dialog" aria-labelledby="dialog-title"><div class="dialog-heading"><h2 id="dialog-title"></h2><button id="dialog-close" class="text-button" type="button" aria-label="닫기">×</button></div><p id="dialog-message" class="notice" role="status" hidden></p><div id="dialog-content"></div></dialog>
  <footer class="site-footer"><span>© ken.blog</span><a class="footer-github" href="https://github.com/gjaku1031/ken-blog" aria-label="GitHub 저장소" title="GitHub">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.56 9.56 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2z"/></svg>
  </a></footer>
</body>
</html>
