# 단일 Spring Boot. 로컬 실행은 실제 운영 설정을 사용하지 않음
# 호스트의 로컬 API 포트
API_PORT=18081
# 실행할 API 이미지 태그
KEN_BLOG_API_IMAGE=ken-blog-api:jvm
# JVM 힙 외 공간까지 포함한 컨테이너 한도 실제 부하에 맞게 조정
# API 컨테이너 전체 메모리 한도
API_MEMORY_LIMIT=1536m
# JVM 외 메모리 여유 비율(%)
BPL_JVM_HEAD_ROOM=10
# JVM 메타스페이스 상한
JAVA_TOOL_OPTIONS=-XX:MaxMetaspaceSize=256m
# 로컬 MySQL 포트
DB_PORT=13306
# DB 계정명
DB_USERNAME=ken_blog
# DB 비밀번호
DB_PASSWORD=
# 로컬 MySQL 관리자 비밀번호
MYSQL_ROOT_PASSWORD=
# 로컬 HTTP 개발용 운영 값은 deploy/compose.production.yaml에서 고정
# HTTPS에서만 쿠키 전송 여부
SESSION_COOKIE_SECURE=false
# 사이트 간 쿠키 전송 정책
SESSION_COOKIE_SAME_SITE=lax
# 쿠키 파티션 사용 여부
SESSION_COOKIE_PARTITIONED=false
# 필요할 때만 로컬 개발용 origin을 지정
# 공개 읽기 허용 origin
APP_CORS_ALLOWED_ORIGINS=
# 쿠키 인증 허용 origin
APP_AUTH_CORS_ALLOWED_ORIGINS=
# DB에 직접 등록한 활성 ADMIN 계정명 계정 생성·비밀번호 갱신 기능 없음
# 인증에 사용할 활성 ADMIN 계정명
ADMIN_USERNAME=

# 이미지는 재시작 뒤에도 유지되는 로컬 디렉터리에 보관
# API 이미지 저장 루트
APP_ASSETS_DIRECTORY=/var/lib/ken-blog/assets
