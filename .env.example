# 기존 서비스의 8080과 분리된 API 로컬 포트.
API_PORT=18081
# 쉼표로 구분한 정적 프론트 origin. 로컬 검증 때만 http://127.0.0.1:14000 추가.
APP_CORS_ALLOWED_ORIGINS=https://gjaku1031.github.io
# 개발 MySQL만 127.0.0.1에 노출. 운영 DB 연결 정보는 이 파일에 넣지 않음.
DB_PORT=13306
DB_USERNAME=ken_blog
# 로컬 .env에서 서로 다른 임의 비밀번호로 채움. 빈 값은 Compose 시작 시 거부.
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
