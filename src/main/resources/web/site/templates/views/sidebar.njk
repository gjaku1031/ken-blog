<aside class="feed-sidebar" aria-label="글 탐색">
  <section class="side-card card">
    <h2>분류</h2>
    <ul class="category-tree">
      {% for category in categories %}<li>
        <div class="category-line">
          <a href="{{ '?category=' + (category | query) }}"><span>{{ category }}</span></a>
        </div>
      </li>{% endfor %}
    </ul>
  </section>
  <section class="side-card card">
    <h2>태그</h2>
    <div class="tag-cloud">
      {% for tag in tags %}<a href="{{ '?tag=' + (tag | query) }}">#{{ tag }}</a>{% endfor %}
    </div>
  </section>
</aside>
