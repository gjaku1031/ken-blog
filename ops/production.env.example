# 저장소 밖 전용 0600 파일로 복사. 운영 MySQL은 기존 스키마/이력 보존.
DB_URL=jdbc:mysql://mysql-host:3306/ken_blog?sslMode=REQUIRED
DB_USERNAME=ken_blog
DB_PASSWORD=
# 운영 HTTPS 세션 쿠키.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_PARTITIONED=false
# 관리자 작성 화면은 Spring /manage/ 동일 출처 사용.
APP_CORS_ALLOWED_ORIGINS=
APP_AUTH_CORS_ALLOWED_ORIGINS=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD_HASH=
ADMIN_USERNAME=
ADMIN_TOTP_SECRET=
ADMIN_RECOVERY_CODE_HASHES=
# 원본 첨부는 비공개 OCI 버킷에 보존.
OCI_OBJECT_STORAGE_ENDPOINT=
OCI_OBJECT_STORAGE_REGION=
OCI_OBJECT_STORAGE_BUCKET=
OCI_OBJECT_STORAGE_ACCESS_KEY=
OCI_OBJECT_STORAGE_SECRET_KEY=
OCI_OBJECT_STORAGE_KEY_PREFIX=ken-blog/attachments
# 로컬 MCP. 공개 프록시에는 노출하지 않음.
APP_MCP_ENABLED=false
APP_MCP_ALLOWED_PEERS=127.0.0.1,::1
APP_MCP_ALLOWED_HOSTS=127.0.0.1:18081
# 서버에만 보관. GitHub repo에는 BLOG_DEPLOY_TOKEN 이름의 별도 secret으로 callback token 등록.
APP_DEPLOY_ENABLED=false
APP_DEPLOY_GITHUB_TOKEN=
APP_DEPLOY_CALLBACK_TOKEN=
APP_DEPLOY_REPOSITORY=gjaku1031/ken-blog
APP_DEPLOY_WORKFLOW=pages.yml
APP_DEPLOY_REF=main
APP_DEPLOY_PAGES_MARKER_URL=https://gjaku1031.github.io/ken-blog/deployment.json
APP_DEPLOY_GITHUB_API_BASE=https://api.github.com
