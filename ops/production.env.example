# 이 파일은 새 앱 전용 빈 MySQL 스키마에만 사용. 기존 운영 app.env를 복사해 사용하지 않음.
DB_URL=jdbc:mysql://DB_HOST:3306/NEW_DEDICATED_SCHEMA?sslMode=VERIFY_IDENTITY
DB_USERNAME=
DB_PASSWORD=
APP_CORS_ALLOWED_ORIGINS=https://gjaku1031.github.io
APP_AUTH_CORS_ALLOWED_ORIGINS=https://gjaku1031.github.io
SESSION_COOKIE_SAME_SITE=none
API_PORT=18081
# 실행 시 셸의 KEN_BLOG_PRODUCTION_ENV_FILE에 이 전용 파일 경로 지정.
# OCI Object Storage: OCI_* 또는 기존 S3_* 이름 중 한 묶음 사용.
OCI_OBJECT_STORAGE_ENDPOINT=
OCI_OBJECT_STORAGE_REGION=
OCI_OBJECT_STORAGE_BUCKET=
OCI_OBJECT_STORAGE_ACCESS_KEY=
OCI_OBJECT_STORAGE_SECRET_KEY=
OCI_OBJECT_STORAGE_KEY_PREFIX=ken-blog/attachments
# 선택적 Redis Cloud 공개 데이터 캐시. TLS 기본 true, 공급자 설정에 맞는 값만 명시.
CACHE_REDIS_ENABLED=false
CACHE_REDIS_HOST=
CACHE_REDIS_PORT=6379
CACHE_REDIS_USERNAME=
CACHE_REDIS_PASSWORD=
CACHE_REDIS_TLS=true
# 외부 SMTP가 모두 설정되기 전에는 초대 발급 503.
INVITATION_WEB_BASE_URL=
INVITATION_FROM=
INVITATION_SMTP_HOST=
INVITATION_SMTP_PORT=587
INVITATION_SMTP_USERNAME=
INVITATION_SMTP_PASSWORD=
# 서비스 계정 권한을 부여한 GA4 숫자 속성 ID. G- 측정 ID와 다름.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON_BASE64=
# 별도 수동 백업/복원 스크립트 입력. DB_NAME은 반드시 위 전용 스키마.
DB_HOST=
DB_PORT=3306
DB_NAME=
BACKUP_DIRECTORY=
MYSQL_SSL_MODE=REQUIRED
