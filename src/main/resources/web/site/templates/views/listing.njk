{# 글 목록·검색·분류 필터와 작성 진입 #}<main id="main-content" class="page-container {{ 'search-page' if searching else 'tech-page posts-page' }}">
  <div class="content-grid">
    <section class="feed-column">
      <div class="section-heading">
        <h1>{{ heading }}</h1>
        {% if section == "Posts" %}<button class="write-button" type="button" data-admin-write data-post-create="TECH" hidden>글쓰기</button>{% endif %}
      </div>
      {# 현재 검색어·결과 건수 표시 위치 #}{% if searching %}<p id="search-filter" class="active-filters" role="status" aria-live="polite" aria-atomic="true">
      </p>{% endif %}
      <div class="post-list">{% include "views/cards.njk" %}</div>
      {% if searching %}<noscript><p>검색에는 JavaScript가 필요합니다. 공개 글 목록을 표시합니다.</p>{% set cards = fallbackCards %}{% include "views/cards.njk" %}</noscript>{% endif %}
      <p id="filter-empty" class="message-card card" hidden>검색 결과가 없습니다.</p>
    </section>
    {# 분류·태그 필터 #}{% include "views/sidebar.njk" %}
  </div>
</main>
