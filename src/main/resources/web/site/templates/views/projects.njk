{# 공개 프로젝트 목록 #}<main id="main-content" class="page-container projects-page">
  <div class="projects-heading">
    <h1>Projects</h1>
  </div>
  <div class="projects-grid">
    {# 정렬된 프로젝트 카드 #}{% for project in projects %}<article class="project-card card hv">
      <div class="project-card-top">
        <span class="project-status {{ 'project-status-' + project.statusClass }}"><span aria-hidden="true"></span>{{ project.statusLabel }}</span>{% if project.period %}<span class="mono project-period">{{ project.period }}</span>{% endif %}
      </div>
      <h2>
        <a href="{{ project.href }}">{{ project.name }}</a>
      </h2>
      <p>{{ project.description }}</p>
      {% if project.stackBadges | length %}<div class="stack-badges" aria-label="기술 배지">
        {% for badge in project.stackBadges %}<span><img alt="" width="22" height="22" src="{{ badge.imageUrl }}">{{ badge.name }}</span>{% endfor %}
      </div>{% endif %}
      <div class="project-card-counts">문서 {{ project.postCount }}개</div>
    </article>{% endfor %}
  </div>
  {# 출간된 프로젝트가 없는 경우 안내 #}{% if not projects | length %}<p class="projects-empty">아직 출간된 프로젝트가 없습니다.</p>{% endif %}
</main>
