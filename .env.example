# 단일 Spring Boot. 로컬 실행은 실제 운영 설정을 사용하지 않음.
API_PORT=18081
DB_PORT=13306
DB_USERNAME=ken_blog
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
# HTTP 개발에서는 false, 운영 HTTPS는 true.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_PARTITIONED=false
# 관리자 작성 화면은 Spring /manage/ 동일 출처 사용.
APP_CORS_ALLOWED_ORIGINS=
APP_AUTH_CORS_ALLOWED_ORIGINS=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD_HASH=
ADMIN_USERNAME=
ADMIN_TOTP_SECRET=
ADMIN_RECOVERY_CODE_HASHES=
# 로컬 MCP. 공개 프록시에는 노출하지 않음.
APP_MCP_ENABLED=false
APP_MCP_ALLOWED_PEERS=127.0.0.1,::1
APP_MCP_ALLOWED_HOSTS=127.0.0.1:18081

# 본문은 저장소 content, 파일은 재시작 뒤에도 유지되는 로컬 디렉터리에 보관.
APP_CONTENT_DIRECTORY=content
APP_ASSETS_DIRECTORY=/var/lib/ken-blog/assets
APP_ASSETS_KEY_PREFIX=ken-blog/attachments
