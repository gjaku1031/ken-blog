<!doctype html><html lang="ko"><head><meta charset="utf-8">{% include "theme-init.njk" %}{% if preserveQuery %}<noscript><meta http-equiv="refresh" content="0;url={{ target }}"></noscript>{% else %}<meta http-equiv="refresh" content="0;url={{ target }}">{% endif %}<link rel="canonical" href="{{ canonical }}"><title>페이지 이동</title></head><body><a id="redirect-target" href="{{ target }}">글로 이동</a>{% if preserveQuery %}<script>
const destination = new URL(document.getElementById('redirect-target').href);
destination.search = location.search;
destination.hash = location.hash;
location.replace(destination.href);
</script>{% endif %}</body></html>
