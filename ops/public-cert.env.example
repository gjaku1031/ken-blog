# 저장소 밖 0600 운영 파일의 비밀 없는 경로 설정 예시. Compose --env-file과 systemd EnvironmentFile에서 함께 사용.
KEN_BLOG_PRODUCTION_ENV_FILE=/home/ubuntu/Develop/infra/ken-blog/production.env
KEN_BLOG_PUBLIC_BIND_IP=10.0.0.93
KEN_BLOG_ACME_WEBROOT_DIR=/home/ubuntu/Develop/infra/ken-blog/acme
KEN_BLOG_CERTBOT_CONFIG_DIR=/home/ubuntu/Develop/infra/ken-blog/letsencrypt
KEN_BLOG_CERTBOT_IMAGE=certbot/certbot:v5.4.0
KEN_BLOG_TLS_DIR=/home/ubuntu/Develop/infra/ken-blog/spring-tls
